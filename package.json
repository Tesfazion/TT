{
  "name": "latest-portfolio",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "ci": "npm run check && npm run lint && npm run build",
    "format": "prettier . --write",
    "lint": "eslint \"src/**/*.astro\""
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "^8.28.0",
    "cross-env": "^10.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-astro": "^1.5.0",
    "postcss": "^8.5.4",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.0",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.2"
  }
}
