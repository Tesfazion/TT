---
import { site } from "../config/site";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
const companyEmail = site.contact.companyEmail?.trim();
const personalEmail = site.contact.personalEmail?.trim();
const whatsappNumber = site.contact.whatsappE164.replace("+", "");
---

<footer class="border-t border-slate-200/60 bg-white/50 py-10 backdrop-blur dark:border-white/10 dark:bg-slate-950/40">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <div class="flex items-center gap-3">
          <img
            src={site.assets.logoMark}
            alt={`${site.brand.companyName} logo`}
            class="h-10 w-10 rounded-2xl border border-slate-200/70 bg-white/70 object-contain p-1.5 shadow-sm dark:border-white/10 dark:bg-white/5"
            loading="lazy"
            decoding="async"
          />
          <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">{site.brand.companyName}</div>
        </div>
        <div class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          {site.brand.name} • {site.brand.role}
        </div>
        <div class="mt-4 text-sm text-slate-600 dark:text-slate-300">
          <div>{site.brand.location}</div>
          <div class="mt-1">{site.brand.availability}</div>
        </div>
      </div>

      <div>
        <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">Contact</div>
        <div class="mt-3 space-y-2 text-sm">
          {
            companyEmail ? (
              <a class="inline-flex items-center gap-2 text-slate-700 hover:underline dark:text-slate-200" href={`mailto:${companyEmail}`}>
                <Icon name="mail" class="h-4 w-4" />
                <span>{companyEmail}</span>
              </a>
            ) : null
          }
          {
            personalEmail ? (
              <a class="inline-flex items-center gap-2 text-slate-700 hover:underline dark:text-slate-200" href={`mailto:${personalEmail}`}>
                <Icon name="mail" class="h-4 w-4" />
                <span>Personal: {personalEmail}</span>
              </a>
            ) : null
          }
          <a class="inline-flex items-center gap-2 text-slate-700 hover:underline dark:text-slate-200" href={`tel:${site.contact.phoneE164}`}>
            <Icon name="phone" class="h-4 w-4" />
            <span>{site.contact.phoneDisplay}</span>
          </a>
          <a class="inline-flex items-center gap-2 text-slate-700 hover:underline dark:text-slate-200" href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noreferrer">
            <Icon name="whatsapp" class="h-4 w-4" />
            <span>WhatsApp: {site.contact.whatsappDisplay}</span>
          </a>
        </div>
      </div>

      <div>
        <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">Legal</div>
        <div class="mt-3 space-y-2 text-sm text-slate-700 dark:text-slate-200">
          <a class="hover:underline" href="/privacy">Privacy</a>
          <a class="hover:underline" href="/contact">Contact</a>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-slate-200/60 pt-6 text-xs text-slate-500 dark:border-white/10 dark:text-slate-400 sm:flex-row sm:items-center sm:justify-between">
      <div>© {year} {site.brand.companyName}. All rights reserved.</div>
    </div>
  </div>
</footer>
