---
import { site } from "../../config/site";
import Icon from "../ui/Icon.astro";

const year = new Date().getFullYear();
const companyEmail = site.contact.companyEmail?.trim();
const personalEmail = site.contact.personalEmail?.trim();
const whatsappNumber = site.contact.whatsappE164.replace("+", "");
---

<footer class="mt-16 border-t border-slate-200/60 bg-white/50 py-12 backdrop-blur dark:border-white/10 dark:bg-slate-950/40">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="surface relative overflow-hidden rounded-3xl p-8">
      <img
        src="/images/tech/wave.svg"
        alt=""
        loading="lazy"
        decoding="async"
        class="pointer-events-none absolute inset-0 h-full w-full opacity-20 dark:opacity-15"
      />
      <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-brand-500/10 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-12 -left-10 h-56 w-56 rounded-full bg-emerald-400/10 blur-3xl"></div>
      <div class="relative flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <div class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Let’s build something great</div>
          <p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-300">
            Need a modern website, a dashboard, or a full-stack app? Tell me what you’re building and I’ll reply with next steps.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a
            href="/contact"
            class="animate-shimmer inline-flex items-center justify-center rounded-xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-glow hover:bg-brand-700"
          >
            Contact
          </a>
          <a
            href="/projects"
            class="surface inline-flex items-center justify-center rounded-xl px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-white/80 dark:text-slate-100 dark:hover:bg-slate-950/60"
          >
            View projects
          </a>
        </div>
      </div>
    </div>

    <div class="mt-10 grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <div class="flex items-center gap-3">
          <img
            src={site.assets.logoMark}
            alt={`${site.company.name} logo`}
            class="h-11 w-11 rounded-2xl border border-slate-200/70 bg-white/70 object-contain p-2 shadow-sm dark:border-white/10 dark:bg-white/5"
            loading="lazy"
            decoding="async"
          />
          <div>
            <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">{site.company.name}</div>
            <div class="mt-0.5 text-xs font-medium text-slate-600 dark:text-slate-300">{site.company.tagline}</div>
          </div>
        </div>

        <div class="mt-4 text-sm text-slate-600 dark:text-slate-300">
          <div class="font-semibold text-slate-900 dark:text-slate-100">{site.person.name}</div>
          <div class="mt-1">{site.person.role} • {site.person.location}</div>
        </div>

        <div class="mt-5 flex flex-wrap gap-2">
          <a
            class="surface focus-ring inline-flex items-center justify-center rounded-xl px-3 py-2 text-slate-800 hover:bg-white/80 dark:text-slate-100 dark:hover:bg-white/10"
            href={site.links.linkedin}
            target="_blank"
            rel="noreferrer"
            aria-label="LinkedIn"
          >
            <Icon name="linkedin" />
          </a>
          <a
            class="surface focus-ring inline-flex items-center justify-center rounded-xl px-3 py-2 text-slate-800 hover:bg-white/80 dark:text-slate-100 dark:hover:bg-white/10"
            href={site.links.github}
            target="_blank"
            rel="noreferrer"
            aria-label="GitHub"
          >
            <Icon name="github" />
          </a>
          <a
            class="surface focus-ring inline-flex items-center justify-center rounded-xl px-3 py-2 text-slate-800 hover:bg-white/80 dark:text-slate-100 dark:hover:bg-white/10"
            href={site.links.x}
            target="_blank"
            rel="noreferrer"
            aria-label="X"
          >
            <Icon name="x" />
          </a>
          <a
            class="surface focus-ring inline-flex items-center justify-center rounded-xl px-3 py-2 text-slate-800 hover:bg-white/80 dark:text-slate-100 dark:hover:bg-white/10"
            href={site.links.telegram}
            target="_blank"
            rel="noreferrer"
            aria-label="Telegram"
          >
            <Icon name="telegram" />
          </a>
        </div>
      </div>

      <div class="md:col-span-3">
        <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">Explore</div>
        <div class="mt-4 space-y-2 text-sm text-slate-700 dark:text-slate-200">
          <a class="hover:underline" href="/">Home</a>
          <a class="hover:underline" href="/about">About</a>
          <a class="hover:underline" href="/projects">Projects</a>
          <a class="hover:underline" href="/company">Company</a>
          <a class="hover:underline" href="/contact">Contact</a>
        </div>
      </div>

      <div class="md:col-span-4">
        <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">Contact</div>
        <div class="mt-4 space-y-2 text-sm">
          {
            personalEmail ? (
              <a class="inline-flex items-center gap-2 text-slate-700 hover:underline dark:text-slate-200" href={`mailto:${personalEmail}`}>
                <Icon name="mail" class="h-4 w-4" />
                <span>{personalEmail}</span>
              </a>
            ) : null
          }
          {
            companyEmail ? (
              <a class="inline-flex items-center gap-2 text-slate-700 hover:underline dark:text-slate-200" href={`mailto:${companyEmail}`}>
                <Icon name="mail" class="h-4 w-4" />
                <span>Studio: {companyEmail}</span>
              </a>
            ) : null
          }
          <a class="inline-flex items-center gap-2 text-slate-700 hover:underline dark:text-slate-200" href={`tel:${site.contact.phoneE164}`}>
            <Icon name="phone" class="h-4 w-4" />
            <span>{site.contact.phoneDisplay}</span>
          </a>
          <a class="inline-flex items-center gap-2 text-slate-700 hover:underline dark:text-slate-200" href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noreferrer">
            <Icon name="whatsapp" class="h-4 w-4" />
            <span>WhatsApp: {site.contact.whatsappDisplay}</span>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-slate-200/60 pt-6 text-xs text-slate-500 dark:border-white/10 dark:text-slate-400 sm:flex-row sm:items-center sm:justify-between">
      <div>© {year} {site.company.name}. All rights reserved.</div>
      <div class="flex items-center gap-3">
        <a class="hover:underline" href="/privacy">Privacy</a>
      </div>
    </div>
  </div>
</footer>

