---
import { site } from "../../config/site";
import Icon from "../ui/Icon.astro";

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-slate-200/60 bg-white/70 shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-950/70">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <a
      href="/"
      class="focus-ring group inline-flex items-center gap-3 rounded-2xl px-2 py-1 text-slate-900 hover:bg-white/80 dark:text-slate-100 dark:hover:bg-slate-900/40"
    >
      <img
        src={site.assets.logo}
        alt={`${site.company.name} logo`}
        class="h-12 w-12 rounded-2xl border border-slate-200/70 bg-white/70 object-contain p-2 shadow-sm sm:h-14 sm:w-14 dark:border-white/10 dark:bg-white/5"
        loading="eager"
        decoding="async"
      />
      <div class="text-base font-semibold tracking-tight sm:text-lg">{site.company.navLabel}</div>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {site.nav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class:list={[
            "rounded-xl px-3 py-2 text-sm font-medium transition",
            isActive(item.href)
              ? "bg-white/90 text-slate-900 shadow-sm dark:bg-slate-900/40 dark:text-white"
              : "text-slate-700 hover:bg-white/80 hover:text-slate-900 dark:text-slate-200 dark:hover:bg-slate-900/40"
          ]}
        >
          {item.label}
        </a>
      ))}

      <button
        data-theme-toggle
        type="button"
        aria-label="Toggle theme"
        class="surface focus-ring ml-2 inline-flex items-center justify-center rounded-xl px-3 py-2 text-slate-700 dark:text-slate-200"
      >
        <span class="sr-only">Toggle theme</span>
        <Icon name="sun" class="h-4 w-4 dark:hidden" />
        <Icon name="moon" class="hidden h-4 w-4 dark:inline" />
      </button>
      <a
        href="/contact"
        class="animate-shimmer ml-2 inline-flex items-center justify-center rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-glow hover:bg-brand-700"
      >
        Contact
      </a>
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <button
        data-theme-toggle
        type="button"
        aria-label="Toggle theme"
        class="surface focus-ring inline-flex items-center justify-center rounded-xl px-3 py-2 text-slate-700 dark:text-slate-200"
      >
        <span class="sr-only">Toggle theme</span>
        <Icon name="sun" class="h-4 w-4 dark:hidden" />
        <Icon name="moon" class="hidden h-4 w-4 dark:inline" />
      </button>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="surface focus-ring inline-flex items-center justify-center rounded-xl px-3 py-2 text-sm font-semibold text-slate-900 hover:bg-white/80 dark:text-slate-100 dark:hover:bg-slate-900/40"
      >
        Menu
      </button>
    </div>
  </div>

  <div id="mobile-nav" hidden class="border-t border-slate-200/60 bg-white/60 backdrop-blur dark:border-white/10 dark:bg-slate-950/80 md:hidden">
    <div class="mx-auto max-w-6xl px-4 py-3 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-1">
        {site.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "rounded-xl px-3 py-2 text-sm font-medium transition",
              isActive(item.href)
                ? "bg-white text-slate-900 shadow-sm dark:bg-slate-900/40 dark:text-white"
                : "text-slate-800 hover:bg-white dark:text-slate-100 dark:hover:bg-slate-900/40"
            ]}
          >
            {item.label}
          </a>
        ))}
        <a
          href="/contact"
          class="mt-2 inline-flex items-center justify-center rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-glow hover:bg-brand-700"
        >
          Contact
        </a>
      </div>
    </div>
  </div>
</header>
