---
import "../styles/global.css";
import { site } from "../config/site";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

export type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
  containerClass?: string;
};

const { title, description, noindex, containerClass: containerClassProp } = Astro.props;
const containerClass = containerClassProp ?? "max-w-6xl";

const pageTitle = title ? `${title} — ${site.person.name}` : site.seo.title;
const pageDescription = description ?? site.seo.description;

const baseUrl = import.meta.env.SITE || site.seo.siteUrl;
const canonicalUrl = new URL(Astro.url.pathname, baseUrl).toString();
const ogImage = new URL("og.svg", baseUrl).toString();

const plausibleDomain = site.analytics?.plausibleDomain?.trim();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={site.person.name} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.person.name} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b0f1a" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />

    {noindex ? <meta name="robots" content="noindex" /> : null}

    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark =
            window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          const theme =
            stored === "light" || stored === "dark" ? stored : prefersDark ? "dark" : "light";
          document.documentElement.dataset.theme = theme;
          if (theme === "dark") document.documentElement.classList.add("dark");
          else document.documentElement.classList.remove("dark");
        } catch {}
      })();
    </script>

    <script type="application/ld+json" is:inline>
      {
        JSON.stringify({
          "@context": "https://schema.org",
          "@type": "Person",
          name: site.person.name,
          jobTitle: site.person.role,
          url: baseUrl,
          ...(site.contact.personalEmail?.trim()
            ? { email: site.contact.personalEmail.trim() }
            : site.contact.companyEmail?.trim()
              ? { email: site.contact.companyEmail.trim() }
              : {}),
          sameAs: [
            site.links.linkedin,
            site.links.github,
            site.links.x,
            site.links.telegram,
            site.links.instagram,
            site.links.facebook
          ].filter(Boolean)
        })
      }
    </script>

    {
      plausibleDomain ? (
        <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js" is:inline></script>
      ) : null
    }
  </head>
  <body class="min-h-dvh font-sans text-slate-900 antialiased dark:text-slate-100">
    <a
      href="#main"
      class="focus-ring sr-only fixed left-4 top-4 z-50 rounded-lg bg-white px-3 py-2 text-sm font-medium text-slate-900 shadow-sm focus:not-sr-only dark:bg-slate-950 dark:text-slate-100"
    >
      Skip to content
    </a>

    <Header />

    <main
      id="main"
      class:list={["mx-auto w-full px-4 pb-20 pt-24 sm:px-6 lg:px-8", containerClass]}
    >
      <slot />
    </main>

    <Footer />

    <script src="../scripts/ui/index.ts"></script>
  </body>
</html>
