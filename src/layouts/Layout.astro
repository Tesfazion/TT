---
import "../styles/global.css";
import { site } from "../config/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";

export type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
};

const { title, description, noindex } = Astro.props;

const pageTitle = title ? `${title} — ${site.brand.companyName}` : site.seo.title;
const pageDescription = description ?? site.seo.description;

const baseUrl = import.meta.env.SITE || site.seo.siteUrl;
const canonicalUrl = new URL(Astro.url.pathname, baseUrl).toString();
const ogImage = new URL("og.svg", baseUrl).toString();

const plausibleDomain = site.analytics?.plausibleDomain?.trim();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={site.brand.name} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.brand.companyName} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b0f1a" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />

    {noindex ? <meta name="robots" content="noindex" /> : null}

    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark =
            window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          const theme =
            stored === "light" || stored === "dark" ? stored : prefersDark ? "dark" : "light";
          document.documentElement.dataset.theme = theme;
          if (theme === "dark") document.documentElement.classList.add("dark");
          else document.documentElement.classList.remove("dark");
        } catch {}
      })();
    </script>

    <script type="application/ld+json" is:inline>
      {
        JSON.stringify({
          "@context": "https://schema.org",
          "@type": "Person",
          name: site.brand.name,
          jobTitle: site.brand.role,
          url: baseUrl,
          ...(site.contact.companyEmail?.trim() ? { email: site.contact.companyEmail.trim() } : {}),
          sameAs: [
            site.links.linkedin,
            site.links.github,
            site.links.x,
            site.links.telegram,
            site.links.instagram,
            site.links.facebook
          ].filter(Boolean)
        })
      }
    </script>

    {
      plausibleDomain ? (
        <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js" is:inline></script>
      ) : null
    }

    <ClientRouter />
  </head>
  <body class="min-h-dvh text-slate-900 antialiased dark:text-slate-100">
    <a
      href="#main"
      class="focus-ring sr-only fixed left-4 top-4 z-50 rounded-lg bg-white px-3 py-2 text-sm font-medium text-slate-900 shadow-sm focus:not-sr-only dark:bg-slate-950 dark:text-slate-100"
    >
      Skip to content
    </a>

    <Header />

    <main id="main" class="mx-auto w-full max-w-6xl px-4 pb-20 pt-24 sm:px-6 lg:px-8">
      <div class="surface mb-10 flex flex-col gap-3 rounded-3xl p-5 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-3">
          <img
            src={site.assets.headshot}
            alt={`${site.brand.name} photo`}
            class="h-10 w-10 rounded-2xl border border-slate-200/70 bg-white/70 object-cover shadow-sm dark:border-white/10 dark:bg-white/5"
            loading="lazy"
            decoding="async"
          />
          <div>
            <div class="text-sm font-semibold tracking-tight text-slate-900 dark:text-white">{site.brand.name}</div>
            <div class="text-xs font-semibold text-slate-600 dark:text-slate-300">{site.brand.role}</div>
          </div>
        </div>
        <div class="text-xs text-slate-500 dark:text-slate-400">
          {site.brand.companyName} • {site.brand.location}
        </div>
      </div>
      <slot />
    </main>

    <Footer />

    <script src="../scripts/ui.ts"></script>
  </body>
</html>
