---
import Layout from "../layouts/Layout.astro";
import { site } from "../config/site";
---

<Layout title="About" description={`A little about ${site.person.name} — what I build and what I’m learning.`}>
  <div class="surface relative mb-10 overflow-hidden rounded-3xl p-8">
    <img
      src="/images/library/it-infrastructure/a6ac98b7add388a11e26f63afd33e783.jpg"
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-18"
      loading="lazy"
      decoding="async"
    />
    <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-4">
        <img
          src={site.assets.headshot}
          alt={`${site.person.name} headshot`}
          class="h-16 w-16 rounded-2xl border border-slate-200/70 bg-white/70 object-cover shadow-sm dark:border-white/10 dark:bg-white/5"
          loading="eager"
          decoding="async"
        />
        <div>
          <div class="text-sm font-semibold text-slate-900 dark:text-white">{site.person.name}</div>
          <div class="mt-1 text-sm text-slate-600 dark:text-slate-300">
            {site.person.role} • {site.person.affiliation} • {site.person.location}
          </div>
        </div>
      </div>
      <a
        href="/contact"
        class="animate-shimmer inline-flex items-center justify-center rounded-xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-glow hover:bg-brand-700"
      >
        Contact
      </a>
    </div>
  </div>

  <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
    <div class="lg:col-span-6">
      <div class="surface relative overflow-hidden rounded-3xl p-6">
        <img
          src="/images/tech/hex.svg"
          alt=""
          loading="lazy"
          decoding="async"
          class="pointer-events-none absolute inset-0 h-full w-full opacity-30"
        />
        <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-brand-500/10 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-12 -left-10 h-56 w-56 rounded-full bg-emerald-400/10 blur-3xl"></div>

        <div class="relative">
          <h1 class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-white">About</h1>

          <dl class="mt-6 grid gap-4 sm:grid-cols-3">
            <div class="surface rounded-2xl p-4">
              <dt class="text-xs font-semibold text-slate-600 dark:text-slate-300">Role</dt>
              <dd class="mt-1 text-sm font-semibold text-slate-900 dark:text-white">{site.person.role}</dd>
            </div>
            <div class="surface rounded-2xl p-4">
              <dt class="text-xs font-semibold text-slate-600 dark:text-slate-300">Age</dt>
              <dd class="mt-1 text-sm font-semibold text-slate-900 dark:text-white">{site.person.age}</dd>
            </div>
            <div class="surface rounded-2xl p-4">
              <dt class="text-xs font-semibold text-slate-600 dark:text-slate-300">Education</dt>
              <dd class="mt-1 text-sm font-semibold text-slate-900 dark:text-white">{site.person.education}</dd>
            </div>
            <div class="surface rounded-2xl p-4">
              <dt class="text-xs font-semibold text-slate-600 dark:text-slate-300">Location</dt>
              <dd class="mt-1 text-sm font-semibold text-slate-900 dark:text-white">{site.person.location}</dd>
            </div>
            <div class="surface rounded-2xl p-4">
              <dt class="text-xs font-semibold text-slate-600 dark:text-slate-300">Availability</dt>
              <dd class="mt-1 text-sm font-semibold text-slate-900 dark:text-white">{site.person.availability}</dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="mt-6">
        <div class="flex items-end justify-between gap-6">
          <div class="text-sm font-semibold text-slate-900 dark:text-white">Focus areas</div>
          <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">What I do best</div>
        </div>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <div class="surface rounded-3xl p-5 card-hover">
            <div class="text-sm font-semibold text-slate-900 dark:text-white">Frontend development</div>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
              Astro • Tailwind • Responsive UI
            </p>
          </div>
          <div class="surface rounded-3xl p-5 card-hover">
            <div class="text-sm font-semibold text-slate-900 dark:text-white">Backend basics</div>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
              Node.js • REST • Data basics
            </p>
          </div>
          <div class="surface rounded-3xl p-5 card-hover">
            <div class="text-sm font-semibold text-slate-900 dark:text-white">UI + performance</div>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
              Clean UI • Accessibility • Speed
            </p>
          </div>
          <div class="surface rounded-3xl p-5 card-hover">
            <div class="text-sm font-semibold text-slate-900 dark:text-white">Problem solving</div>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
              CS fundamentals • Debugging
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="lg:col-span-6">
      <div class="surface rounded-3xl p-6">
        <h2 class="text-base font-semibold text-slate-900 dark:text-white">A bit more about me</h2>
        <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
          I’m a Computer Science student at Dilla University. I enjoy building websites that feel clean, load fast, and
          look good on any screen.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
          Most of my learning comes from shipping small projects — trying things, breaking things, and improving the next
          version.
        </p>

        <div class="mt-6">
          <div class="flex items-end justify-between gap-6">
            <div class="text-sm font-semibold text-slate-900 dark:text-white">Right now</div>
            <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">What I’m focusing on</div>
          </div>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <div class="surface relative overflow-hidden rounded-2xl p-5 card-hover">
              <img
                src="/images/library/web-designing/6a5fbcdafb52ed86f72a836d55b49998.jpg"
                alt=""
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover opacity-12"
              />
              <div class="relative">
                <div class="text-sm font-semibold text-slate-900 dark:text-white">Better UI</div>
                <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Spacing, typography, and accessible components.</p>
              </div>
            </div>
            <div class="surface relative overflow-hidden rounded-2xl p-5 card-hover">
              <img
                src="/images/library/software-dev/b4073ae822c46bc169e18a42f49bba08.jpg"
                alt=""
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover opacity-12"
              />
              <div class="relative">
                <div class="text-sm font-semibold text-slate-900 dark:text-white">TypeScript practice</div>
                <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Writing clearer, safer code without overcomplicating it.</p>
              </div>
            </div>
            <div class="surface relative overflow-hidden rounded-2xl p-5 card-hover">
              <img
                src="/images/library/it-infrastructure/a6ac98b7add388a11e26f63afd33e783.jpg"
                alt=""
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover opacity-12"
              />
              <div class="relative">
                <div class="text-sm font-semibold text-slate-900 dark:text-white">Backend basics</div>
                <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Simple REST APIs and how data flows end‑to‑end.</p>
              </div>
            </div>
            <div class="surface relative overflow-hidden rounded-2xl p-5 card-hover">
              <img
                src="/images/library/iot/0ff80ff403ccbaec02653cb72775eefa.jpg"
                alt=""
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover opacity-12"
              />
              <div class="relative">
                <div class="text-sm font-semibold text-slate-900 dark:text-white">CS fundamentals</div>
                <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Algorithms, problem solving, and clean debugging.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 rounded-2xl border border-white/10 bg-slate-950/70 p-5">
          <div class="text-sm font-semibold text-white">Want to work together?</div>
          <p class="mt-2 text-sm text-slate-300">
            Send a message — I’ll reply when I’m online.
          </p>
          <a
            href="/contact"
            class="mt-4 inline-flex items-center justify-center rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-glow hover:bg-brand-700"
          >
            Contact
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
