---
import Layout from "../layouts/Layout.astro";
import { site } from "../config/site";
import Icon from "../components/ui/Icon.astro";

const companyEmail = site.contact.companyEmail?.trim();
const personalEmail = site.contact.personalEmail?.trim();
const primaryEmail = personalEmail || companyEmail;
const whatsappNumber = site.contact.whatsappE164.replace("+", "");

const emailSubject = encodeURIComponent("Hello Tesfatseyon — from your portfolio site");
const emailBody = encodeURIComponent(
  [
    "Hi Tesfatseyon,",
    "",
    "My name: ",
    "I’m reaching out about: ",
    "Timeline: ",
    "Budget (optional): ",
    "",
    "Message:"
  ].join("\n")
);
---

<Layout title="Contact" description="Contact me for freelance work, jobs, or collaboration.">
  <section class="surface relative overflow-hidden rounded-3xl p-8">
    <img
      src="/images/library/iot/b66694e550998d6ef5a9c6cb6ca22c74.jpg"
      alt=""
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover opacity-20"
    />
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_25%_20%,rgba(245,158,11,0.22),transparent_60%)]"></div>
    <div class="relative flex flex-col gap-2">
      <h1 class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-white">Contact</h1>
      <p class="max-w-2xl text-sm leading-relaxed text-slate-600 dark:text-slate-300">
        Want to collaborate, ask a question, or talk about a project? Here are the easiest ways to reach me. If it’s work related, feel free to use the studio email.
      </p>
    </div>
  </section>

  <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:items-start">
    <div class="lg:col-span-5">
      <div class="surface rounded-3xl p-6">
        <div class="text-sm font-semibold text-slate-900 dark:text-white">Direct</div>
        <div class="mt-4 grid gap-2">
          {
            companyEmail ? (
              <a
                class="surface focus-ring flex items-center justify-between gap-4 rounded-2xl px-4 py-3 text-sm font-semibold text-slate-900 hover:bg-white/90 dark:text-slate-100 dark:hover:bg-slate-900/40"
                href={`mailto:${companyEmail}`}
              >
                <span class="flex items-center gap-3">
                  <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-50 text-brand-700 dark:bg-white/5 dark:text-brand-200">
                    <Icon name="mail" class="h-5 w-5" />
                  </span>
                  <span>
                    <span class="block text-xs font-semibold text-slate-500 dark:text-slate-400">Studio email</span>
                    <span class="block">{companyEmail}</span>
                  </span>
                </span>
                <Icon name="arrow" class="h-4 w-4 text-slate-500 dark:text-slate-400" />
              </a>
            ) : null
          }
          {
            personalEmail ? (
              <a
                class="surface focus-ring flex items-center justify-between gap-4 rounded-2xl px-4 py-3 text-sm font-semibold text-slate-900 hover:bg-white/90 dark:text-slate-100 dark:hover:bg-slate-900/40"
                href={`mailto:${personalEmail}`}
              >
                <span class="flex items-center gap-3">
                  <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-700 dark:bg-white/5 dark:text-emerald-200">
                    <Icon name="mail" class="h-5 w-5" />
                  </span>
                  <span>
                    <span class="block text-xs font-semibold text-slate-500 dark:text-slate-400">Personal email</span>
                    <span class="block">{personalEmail}</span>
                  </span>
                </span>
                <Icon name="arrow" class="h-4 w-4 text-slate-500 dark:text-slate-400" />
              </a>
            ) : null
          }
          <a
            class="surface focus-ring flex items-center justify-between gap-4 rounded-2xl px-4 py-3 text-sm font-semibold text-slate-900 hover:bg-white/90 dark:text-slate-100 dark:hover:bg-slate-900/40"
            href={`tel:${site.contact.phoneE164}`}
          >
            <span class="flex items-center gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-700 dark:bg-white/5 dark:text-indigo-200">
                <Icon name="phone" class="h-5 w-5" />
              </span>
              <span>
                <span class="block text-xs font-semibold text-slate-500 dark:text-slate-400">Phone</span>
                <span class="block">{site.contact.phoneDisplay}</span>
              </span>
            </span>
            <Icon name="arrow" class="h-4 w-4 text-slate-500 dark:text-slate-400" />
          </a>
          <a
            class="surface focus-ring flex items-center justify-between gap-4 rounded-2xl px-4 py-3 text-sm font-semibold text-slate-900 hover:bg-white/90 dark:text-slate-100 dark:hover:bg-slate-900/40"
            href={`https://wa.me/${whatsappNumber}`}
            target="_blank"
            rel="noreferrer"
          >
            <span class="flex items-center gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-700 dark:bg-white/5 dark:text-emerald-200">
                <Icon name="whatsapp" class="h-5 w-5" />
              </span>
              <span>
                <span class="block text-xs font-semibold text-slate-500 dark:text-slate-400">WhatsApp</span>
                <span class="block">{site.contact.whatsappDisplay}</span>
              </span>
            </span>
            <Icon name="arrow" class="h-4 w-4 text-slate-500 dark:text-slate-400" />
          </a>
          <a
            class="surface focus-ring flex items-center justify-between gap-4 rounded-2xl px-4 py-3 text-sm font-semibold text-slate-900 hover:bg-white/90 dark:text-slate-100 dark:hover:bg-slate-900/40"
            href={site.links.telegram}
            target="_blank"
            rel="noreferrer"
          >
            <span class="flex items-center gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-sky-50 text-sky-700 dark:bg-white/5 dark:text-sky-200">
                <Icon name="telegram" class="h-5 w-5" />
              </span>
              <span>
                <span class="block text-xs font-semibold text-slate-500 dark:text-slate-400">Telegram</span>
                <span class="block">@Zizo1616</span>
              </span>
            </span>
            <Icon name="arrow" class="h-4 w-4 text-slate-500 dark:text-slate-400" />
          </a>
        </div>
        <div class="mt-6 text-xs text-slate-500 dark:text-slate-400">
          Typical response time: 24-48 hours (weekdays).
        </div>
      </div>

      <div class="surface mt-6 rounded-3xl p-6">
        <div class="text-sm font-semibold text-slate-900 dark:text-white">Online</div>
        <div class="mt-4 flex flex-wrap gap-2">
          <a class="surface focus-ring inline-flex items-center justify-center rounded-xl px-3 py-2 text-slate-800 hover:bg-white/80 dark:text-slate-100 dark:hover:bg-white/10" href={site.links.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">
            <Icon name="linkedin" />
          </a>
          <a class="surface focus-ring inline-flex items-center justify-center rounded-xl px-3 py-2 text-slate-800 hover:bg-white/80 dark:text-slate-100 dark:hover:bg-white/10" href={site.links.github} target="_blank" rel="noreferrer" aria-label="GitHub">
            <Icon name="github" />
          </a>
          <a class="surface focus-ring inline-flex items-center justify-center rounded-xl px-3 py-2 text-slate-800 hover:bg-white/80 dark:text-slate-100 dark:hover:bg-white/10" href={site.links.instagram} target="_blank" rel="noreferrer" aria-label="Instagram">
            <Icon name="instagram" />
          </a>
          <a class="surface focus-ring inline-flex items-center justify-center rounded-xl px-3 py-2 text-slate-800 hover:bg-white/80 dark:text-slate-100 dark:hover:bg-white/10" href={site.links.facebook} target="_blank" rel="noreferrer" aria-label="Facebook">
            <Icon name="facebook" />
          </a>
          <a class="surface focus-ring inline-flex items-center justify-center rounded-xl px-3 py-2 text-slate-800 hover:bg-white/80 dark:text-slate-100 dark:hover:bg-white/10" href={site.links.x} target="_blank" rel="noreferrer" aria-label="X">
            <Icon name="x" />
          </a>
          <a class="surface focus-ring inline-flex items-center justify-center rounded-xl px-3 py-2 text-slate-800 hover:bg-white/80 dark:text-slate-100 dark:hover:bg-white/10" href={site.links.telegram} target="_blank" rel="noreferrer" aria-label="Telegram">
            <Icon name="telegram" />
          </a>
        </div>
      </div>
    </div>

    <div class="lg:col-span-7">
      {
        primaryEmail ? (
          <section class="surface relative overflow-hidden rounded-3xl p-6">
            <img
              src="/images/tech/hex.svg"
              alt=""
              loading="lazy"
              decoding="async"
              class="pointer-events-none absolute inset-0 h-full w-full opacity-25"
            />
            <div class="pointer-events-none absolute -right-10 -top-10 h-36 w-36 rounded-full bg-brand-500/10 blur-2xl"></div>
            <div class="pointer-events-none absolute -bottom-12 -left-10 h-48 w-48 rounded-full bg-emerald-400/10 blur-2xl"></div>
            <div class="relative">
              <h2 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Send a quick message</h2>
              <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                I keep this site fully static, so the “form” is just a clean email template. Click once and your email app will open.
              </p>

              <div class="mt-6 grid gap-3 sm:grid-cols-2">
                <a
                  class="focus-ring inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-glow hover:bg-brand-700"
                  href={`mailto:${primaryEmail}?subject=${emailSubject}&body=${emailBody}`}
                >
                  <Icon name="mail" class="h-4 w-4" />
                  Email me
                </a>
                <a
                  class="focus-ring inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white/70 px-5 py-3 text-sm font-semibold text-slate-900 shadow-sm hover:bg-white dark:border-white/10 dark:bg-white/5 dark:text-white dark:hover:bg-white/10"
                  href={`https://wa.me/${whatsappNumber}`}
                  target="_blank"
                  rel="noreferrer"
                >
                  <Icon name="whatsapp" class="h-4 w-4" />
                  WhatsApp
                </a>
              </div>

              <div class="mt-6 surface rounded-2xl p-5">
                <div class="text-sm font-semibold text-slate-900 dark:text-white">What to include</div>
                <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-slate-700 marker:text-brand-600 dark:text-slate-200 dark:marker:text-brand-400">
                  <li>What you want to build (a website, portfolio, app, dashboard…)</li>
                  <li>Your timeline (even a rough estimate is fine)</li>
                  <li>Any links or screenshots you already have</li>
                </ul>
              </div>
            </div>
          </section>
        ) : (
          <div class="rounded-3xl border border-white/10 bg-slate-950/70 p-8 shadow-glow">
            <h2 class="text-2xl font-semibold tracking-tight text-white">Fastest way to reach me</h2>
            <p class="mt-2 text-sm text-slate-300">
              Use WhatsApp or Telegram for a quick response. If you prefer email, add it in{" "}
              <code class="font-mono text-xs text-slate-200">src/config/site.ts</code>.
            </p>
            <div class="mt-6 grid gap-3 sm:grid-cols-2">
              <a
                href={`https://wa.me/${whatsappNumber}`}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-glow hover:bg-brand-700"
              >
                <Icon name="whatsapp" class="h-4 w-4" />
                WhatsApp
              </a>
              <a
                href={site.links.telegram}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-5 py-3 text-sm font-semibold text-white hover:bg-white/10"
              >
                <Icon name="telegram" class="h-4 w-4" />
                Telegram
              </a>
            </div>
          </div>
        )
      }
    </div>
  </div>
</Layout>
