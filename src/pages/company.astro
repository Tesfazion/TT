---
import Layout from "../layouts/Layout.astro";
import { site } from "../config/site";
---

<Layout title="Company" description={`${site.company.name}: ${site.company.tagline}`}>
  <section class="surface relative overflow-hidden rounded-3xl p-8">
    <img
      src="/images/library/it-infrastructure/48347ff86b2cbb0cba16a5090012373f.jpg"
      alt=""
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover opacity-18"
    />
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_25%_20%,rgba(245,158,11,0.20),transparent_60%)]"></div>
    <div class="relative flex flex-col gap-3">
      <div class="flex items-center gap-4">
        <img
          src={site.assets.logo}
          alt={`${site.company.name} logo`}
          class="h-14 w-auto rounded-2xl bg-white/55 p-3 shadow-sm backdrop-blur dark:bg-white/5"
          loading="eager"
        />
        <div>
          <h1 class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-white">{site.company.name}</h1>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">{site.company.tagline}</p>
        </div>
      </div>
    </div>
  </section>

  <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:items-start">
    <div class="lg:col-span-6">
      <h2 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">What it is</h2>
      <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
        {site.company.name} is the umbrella I use for client work. My personal portfolio is about me; this page is about the studio and the services I offer for teams and businesses.
      </p>

      <div class="surface mt-6 rounded-3xl p-6">
        <div class="text-sm font-semibold text-slate-900 dark:text-white">Services</div>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {site.services.map((s) => (
            <div class="surface rounded-2xl p-4">
              <div class="text-sm font-semibold text-slate-900 dark:text-white">{s.title}</div>
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{s.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="lg:col-span-6">
      <div class="rounded-3xl border border-white/10 bg-slate-950/70 p-8 shadow-glow">
        <h2 class="text-xl font-semibold tracking-tight text-white">Work with {site.company.name}</h2>
        <p class="mt-2 text-sm text-slate-300">
          Share your goals, timeline, and budget. I’ll reply with a simple plan and next steps.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a
            href="/contact"
            class="inline-flex items-center justify-center rounded-xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-glow hover:bg-brand-700"
          >
            Contact
          </a>
          <a
            href="/case-studies"
            class="inline-flex items-center justify-center rounded-xl border border-white/10 bg-white/5 px-5 py-3 text-sm font-semibold text-white hover:bg-white/10"
          >
            See case studies
          </a>
        </div>

        <div class="mt-6 flex flex-wrap gap-2 text-xs font-semibold text-slate-200">
          {site.trust.map((t) => (
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">{t}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>
