---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("insights");
  return entries.map((entry) => ({ params: { id: entry.id } }));
}

const { id } = Astro.params;
if (!id) throw new Error("Missing insight id");

const entry = await getEntry("insights", id);
if (!entry) return Astro.redirect("/404");

const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.summary}>
  <section class="surface relative overflow-hidden rounded-3xl p-8">
    <img
      src="/images/library/iot/0ff80ff403ccbaec02653cb72775eefa.jpg"
      alt=""
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover opacity-18"
    />
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_30%,rgba(34,197,94,0.14),transparent_60%)]"></div>
    <div class="relative flex flex-col gap-2">
      <a class="text-sm font-semibold text-brand-700 hover:underline dark:text-brand-300" href="/insights">
        ← Back to insights
      </a>
      <h1 class="text-balance text-3xl font-semibold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        {entry.data.title}
      </h1>
      <div class="mt-1 flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-600 dark:text-slate-300">
        <span class="surface rounded-full px-3 py-1">
          {new Date(entry.data.publishedAt).toLocaleDateString()}
        </span>
        {entry.data.tags.map((t) => (
          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-800 dark:bg-white/5 dark:text-brand-200">
            {t}
          </span>
        ))}
      </div>
      <p class="max-w-2xl text-sm text-slate-600 dark:text-slate-300">{entry.data.summary}</p>
    </div>
  </section>

  <article class="prose prose-slate prose-brand mt-10 max-w-none dark:prose-invert">
    <Content />
  </article>
</Layout>
