---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("insights")).sort(
  (a, b) => +new Date(b.data.publishedAt) - +new Date(a.data.publishedAt)
);
---

<Layout title="Insights" description="Leadership, architecture, delivery systems, and scaling products.">
  <section class="surface relative overflow-hidden rounded-3xl p-8">
    <img
      src="/images/library/iot/0ff80ff403ccbaec02653cb72775eefa.jpg"
      alt=""
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover opacity-18"
    />
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_30%,rgba(34,197,94,0.16),transparent_60%)]"></div>
    <div class="relative flex flex-col gap-2">
      <h1 class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-white">Insights</h1>
      <p class="max-w-2xl text-sm text-slate-600 dark:text-slate-300">
        Practical notes written for founders, executives, and builders.
      </p>
    </div>
  </section>

  <div class="mt-8 grid gap-4 md:grid-cols-2">
    {posts.map((p) => (
      <a
        href={`/insights/${p.id}`}
        class="surface group rounded-3xl p-6 card-hover"
      >
        <div class="text-xs font-semibold text-slate-600 dark:text-slate-300">
          {new Date(p.data.publishedAt).toLocaleDateString()}
        </div>
        <h2 class="mt-3 text-lg font-semibold text-slate-900 group-hover:underline dark:text-white">{p.data.title}</h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{p.data.summary}</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {p.data.tags.slice(0, 4).map((t) => (
            <span class="surface rounded-full px-3 py-1 text-xs font-semibold text-slate-700 dark:text-slate-200">
              {t}
            </span>
          ))}
        </div>
      </a>
    ))}
  </div>
</Layout>
