---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { site } from "../../config/site";

const projects = (await getCollection("projects")).sort(
  (a, b) => +new Date(b.data.publishedAt) - +new Date(a.data.publishedAt)
);
---

<Layout title="Projects" description={`Projects by ${site.person.name} — selected builds, experiments, and client work.`}>
  <section class="surface relative overflow-hidden rounded-3xl p-8">
    <img
      src="/images/library/software-dev/b4073ae822c46bc169e18a42f49bba08.jpg"
      alt=""
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover opacity-20"
    />
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(245,158,11,0.26),transparent_55%)]"></div>
    <div class="relative flex flex-col gap-2">
      <h1 class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-white">Projects</h1>
      <p class="max-w-2xl text-sm text-slate-600 dark:text-slate-300">
        Selected builds across websites, web apps, and automations — optimized for speed, clarity, and real-world use.
      </p>
    </div>
  </section>

  <div class="mt-8 grid gap-4 md:grid-cols-2">
    {projects.map((p) => (
      <a
        href={`/projects/${p.id}`}
        class="surface group relative overflow-hidden rounded-3xl p-6 card-hover"
      >
        <img
          src="/images/tech/hex.svg"
          alt=""
          loading="lazy"
          decoding="async"
          class="pointer-events-none absolute inset-0 h-full w-full opacity-0 transition-opacity duration-500 group-hover:opacity-35 dark:group-hover:opacity-25"
        />
        <div class="pointer-events-none absolute -right-10 -top-10 h-32 w-32 rounded-full bg-brand-500/10 blur-2xl"></div>
        <div class="pointer-events-none absolute -bottom-12 -left-10 h-40 w-40 rounded-full bg-emerald-400/10 blur-2xl"></div>
        <div class="relative">
          {p.data.image ? (
            <div class="relative mb-4 overflow-hidden rounded-2xl border border-slate-200/70 dark:border-white/10">
              <img
                src={p.data.image}
                alt=""
                loading="lazy"
                decoding="async"
                class="h-36 w-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-transparent"></div>
            </div>
          ) : null}
          <div class="flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-600 dark:text-slate-300">
            <span class="surface rounded-full px-3 py-1">{p.data.category}</span>
            <span class="surface rounded-full px-3 py-1">{new Date(p.data.publishedAt).toLocaleDateString()}</span>
            {p.data.featured ? (
              <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-800 dark:bg-white/5 dark:text-brand-200">
                Featured
              </span>
            ) : null}
          </div>
          <h2 class="mt-3 text-lg font-semibold text-slate-900 group-hover:underline dark:text-white">{p.data.title}</h2>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{p.data.summary}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {p.data.stack.slice(0, 6).map((t) => (
              <span class="surface rounded-full px-3 py-1 text-xs font-semibold text-slate-700 dark:text-slate-200">
                {t}
              </span>
            ))}
          </div>
        </div>
      </a>
    ))}
  </div>
</Layout>
