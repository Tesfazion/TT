---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/ui/Icon.astro";

export async function getStaticPaths() {
  const entries = await getCollection("projects");
  return entries.map((entry) => ({ params: { id: entry.id } }));
}

const { id } = Astro.params;
if (!id) throw new Error("Missing project id");

const entry = await getEntry("projects", id);
if (!entry) return Astro.redirect("/404");

const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.summary}>
  <div class="flex flex-col gap-2">
    <a class="text-sm font-semibold text-brand-700 hover:underline dark:text-brand-300" href="/projects">
      ← Back to projects
    </a>
    <h1 class="text-balance text-3xl font-semibold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
      {entry.data.title}
    </h1>
    <p class="max-w-2xl text-sm text-slate-600 dark:text-slate-300">{entry.data.summary}</p>
  </div>

  {entry.data.image ? (
    <div class="surface relative mt-8 overflow-hidden rounded-3xl">
      <img
        src={entry.data.image}
        alt=""
        loading="lazy"
        decoding="async"
        class="h-64 w-full object-cover"
      />
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950/55 via-transparent to-transparent"></div>
    </div>
  ) : null}

  <div class="mt-8 flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-600 dark:text-slate-300">
    <span class="surface rounded-full px-3 py-1">{entry.data.category}</span>
    <span class="surface rounded-full px-3 py-1">{new Date(entry.data.publishedAt).toLocaleDateString()}</span>
    {entry.data.featured ? (
      <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-800 dark:bg-white/5 dark:text-brand-200">
        Featured
      </span>
    ) : null}
  </div>

  <div class="mt-10 grid gap-6 lg:grid-cols-12">
    <article class="prose prose-slate max-w-none dark:prose-invert lg:col-span-8">
      <Content />
    </article>
    <aside class="lg:col-span-4">
      <div class="surface sticky top-24 rounded-3xl p-6">
        <div class="text-sm font-semibold text-slate-900 dark:text-white">Stack</div>
        <div class="mt-3 flex flex-wrap gap-2">
          {entry.data.stack.map((t) => (
            <span class="surface rounded-full px-3 py-1 text-xs font-semibold text-slate-700 dark:text-slate-200">
              {t}
            </span>
          ))}
        </div>

        <div class="mt-6 grid gap-2">
          {entry.data.repoUrl ? (
            <a
              class="focus-ring inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-glow hover:bg-brand-700"
              href={entry.data.repoUrl}
              target="_blank"
              rel="noreferrer"
            >
              <Icon name="github" class="h-4 w-4" />
              Repo
            </a>
          ) : null}

          {entry.data.liveUrl ? (
            <a
              class="focus-ring inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white/60 px-4 py-2 text-sm font-semibold text-slate-900 shadow-sm hover:bg-white dark:border-white/10 dark:bg-white/5 dark:text-white dark:hover:bg-white/10"
              href={entry.data.liveUrl}
              target="_blank"
              rel="noreferrer"
            >
              Live demo
              <Icon name="arrow" class="h-4 w-4" />
            </a>
          ) : null}
        </div>
      </div>
    </aside>
  </div>
</Layout>
