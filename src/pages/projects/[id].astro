---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/ui/Icon.astro";

export async function getStaticPaths() {
  const entries = await getCollection("projects");
  return entries.map((entry) => ({ params: { id: entry.id } }));
}

const { id } = Astro.params;
if (!id) throw new Error("Missing project id");

const entry = await getEntry("projects", id);
if (!entry) return Astro.redirect("/404");

const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.summary} containerClass="max-w-screen-2xl">
  <section class="surface relative overflow-hidden rounded-3xl p-8">
    {entry.data.image ? (
      <img
        src={entry.data.image}
        alt=""
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover opacity-18"
      />
    ) : (
      <img
        src="/images/tech/hex.svg"
        alt=""
        loading="lazy"
        decoding="async"
        class="pointer-events-none absolute inset-0 h-full w-full opacity-25"
      />
    )}
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_10%,rgba(99,102,241,0.20),transparent_60%)]"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-white/40 via-white/10 to-white/0 dark:from-slate-950/30 dark:via-slate-950/20 dark:to-slate-950/0"></div>

    <div class="relative grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <a class="text-sm font-semibold text-brand-700 hover:underline dark:text-brand-300" href="/projects">
          ← Back to projects
        </a>
        <h1 class="mt-3 text-balance text-3xl font-semibold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
          {entry.data.title}
        </h1>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 dark:text-slate-300">{entry.data.summary}</p>

        <div class="mt-5 flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-700 dark:text-slate-200">
          <span class="surface rounded-full px-3 py-1">{entry.data.category}</span>
          <span class="surface rounded-full px-3 py-1">{new Date(entry.data.publishedAt).toLocaleDateString()}</span>
          {entry.data.featured ? (
            <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-800 dark:bg-white/5 dark:text-brand-200">
              Featured
            </span>
          ) : null}
          <span class="surface rounded-full px-3 py-1">{entry.data.stack.length} tech</span>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="surface-strong rounded-3xl p-6">
          <div class="text-sm font-semibold text-slate-900 dark:text-white">Quick actions</div>
          <div class="mt-4 grid gap-2 sm:grid-cols-2">
            {entry.data.repoUrl ? (
              <a
                class="focus-ring inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-glow hover:bg-brand-700"
                href={entry.data.repoUrl}
                target="_blank"
                rel="noreferrer"
              >
                <Icon name="github" class="h-4 w-4" />
                Repo
              </a>
            ) : (
              <div class="surface inline-flex items-center justify-center rounded-xl px-4 py-2 text-sm font-semibold text-slate-500 dark:text-slate-400">
                Repo: private
              </div>
            )}

            {entry.data.liveUrl ? (
              <a
                class="focus-ring inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white/70 px-4 py-2 text-sm font-semibold text-slate-900 shadow-sm hover:bg-white dark:border-white/10 dark:bg-white/5 dark:text-white dark:hover:bg-white/10"
                href={entry.data.liveUrl}
                target="_blank"
                rel="noreferrer"
              >
                Live demo
                <Icon name="arrow" class="h-4 w-4" />
              </a>
            ) : (
              <div class="surface inline-flex items-center justify-center rounded-xl px-4 py-2 text-sm font-semibold text-slate-500 dark:text-slate-400">
                Live demo: —
              </div>
            )}
          </div>

          <div class="mt-6 text-sm font-semibold text-slate-900 dark:text-white">Tech stack</div>
          <div class="mt-3 flex flex-wrap gap-2">
            {entry.data.stack.map((t) => (
              <span class="surface rounded-full px-3 py-1 text-xs font-semibold text-slate-700 dark:text-slate-200">
                {t}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="mt-10 grid gap-6 lg:grid-cols-12">
    <article class="lg:col-span-8">
      <div class="surface rounded-3xl p-6">
        <div class="prose prose-slate max-w-none dark:prose-invert">
          <Content />
        </div>
      </div>
    </article>

    <aside class="lg:col-span-4">
      <div class="surface sticky top-24 rounded-3xl p-6">
        <div class="text-sm font-semibold text-slate-900 dark:text-white">Project summary</div>
        <dl class="mt-4 grid gap-3">
          <div class="flex items-center justify-between gap-4 text-sm">
            <dt class="text-slate-600 dark:text-slate-300">Category</dt>
            <dd class="font-semibold text-slate-900 dark:text-white">{entry.data.category}</dd>
          </div>
          <div class="flex items-center justify-between gap-4 text-sm">
            <dt class="text-slate-600 dark:text-slate-300">Published</dt>
            <dd class="font-semibold text-slate-900 dark:text-white">
              {new Date(entry.data.publishedAt).toLocaleDateString()}
            </dd>
          </div>
          <div class="flex items-center justify-between gap-4 text-sm">
            <dt class="text-slate-600 dark:text-slate-300">Stack</dt>
            <dd class="font-semibold text-slate-900 dark:text-white">{entry.data.stack.length} items</dd>
          </div>
        </dl>

        <div class="mt-6 rounded-2xl border border-white/10 bg-slate-950/70 p-5">
          <div class="text-sm font-semibold text-white">Want a similar build?</div>
          <p class="mt-2 text-sm text-slate-300">
            Share your goals and timeline — I’ll reply with a plan and next steps.
          </p>
          <a
            href="/contact"
            class="mt-4 inline-flex w-full items-center justify-center rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-glow hover:bg-brand-700"
          >
            Contact
          </a>
        </div>
      </div>
    </aside>
  </div>
</Layout>
