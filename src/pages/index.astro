---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { site } from "../config/site";

const projects = (await getCollection("projects"))
  .sort((a, b) => +new Date(b.data.publishedAt) - +new Date(a.data.publishedAt))
  .filter((p) => p.data.featured)
  .slice(0, 6);

const gallery = [
  "/images/library/web-designing/1bef907a0a1af5edfffd7e027c487082.jpg",
  "/images/library/software-dev/6a1cf8409865403dbe6ea823e974400d.jpg",
  "/images/library/iot/0ff80ff403ccbaec02653cb72775eefa.jpg",
  "/images/library/it-infrastructure/48347ff86b2cbb0cba16a5090012373f.jpg",
  "/images/library/cyber-security/9ad3fb14fec1877b220d02187e4e8494.jpg",
  "/images/library/cyber-security/b234332a95eb0a31dd1eda6a7e6693b2.jpg"
] as const;
---

<Layout>
  <section class="grid gap-10 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-7">
      <div
        class="surface inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold text-slate-700 dark:text-slate-200"
      >
        <span class="inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
        {site.person.availability}
      </div>

      <h1 class="animate-fade-in-up mt-5 text-balance text-4xl font-semibold tracking-tight text-slate-900 dark:text-white sm:text-5xl">
        <span class="animate-gradient bg-gradient-to-r from-brand-600 via-brand-400 to-emerald-400 bg-clip-text text-transparent">
          {site.person.name}
        </span>
        <span class="mt-3 block text-pretty text-lg font-semibold tracking-normal text-slate-700 dark:text-slate-200 sm:text-xl">
          {site.person.role} • {site.person.affiliation} • {site.person.location}
        </span>
        <span class="mt-2 block">{site.person.headline}</span>
      </h1>

      <div class="mt-4 flex flex-wrap items-center gap-2">
        {site.person.skills.map((s) => (
          <span class="surface rounded-full px-3 py-1 text-xs font-semibold text-slate-700 dark:text-slate-200">{s}</span>
        ))}
      </div>
      <p class="mt-4 max-w-3xl text-pretty text-base leading-relaxed text-slate-600 dark:text-slate-300 sm:text-lg">
        {site.person.subheadline}
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="/projects"
          class="animate-shimmer inline-flex items-center justify-center rounded-xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-glow hover:bg-brand-700"
        >
          View projects
        </a>
        <a
          href="/contact"
          class="surface inline-flex items-center justify-center rounded-xl px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-white/80 dark:text-slate-100 dark:hover:bg-slate-950/60"
        >
          Contact me
        </a>
      </div>

      <dl class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {site.highlights.map((h) => (
          <div
            class="surface rounded-2xl p-4"
          >
            <dt class="text-xs font-semibold text-slate-600 dark:text-slate-300">{h.label}</dt>
            <dd class="mt-1 text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">{h.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="lg:col-span-5">
      <div class="relative pb-10 md:pb-14">
        <div class="relative isolate aspect-[4/5] overflow-hidden rounded-3xl border border-white/10 shadow-glow">
          <img
            src={site.assets.headshot}
            alt={`${site.person.name} photo`}
            class="absolute inset-0 h-full w-full object-cover"
            loading="eager"
            decoding="async"
          />
          <img
            src="/images/library/software-dev/b31c608108475fea6cd7e49e3a2dd46e.jpg"
            alt=""
            class="absolute inset-0 h-full w-full object-cover opacity-18 mix-blend-overlay"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/35 to-slate-950/10"></div>
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(245,158,11,0.26),transparent_55%)]"></div>
          <div class="animate-float absolute -right-10 -top-10 h-40 w-40 rounded-full bg-emerald-400/12 blur-2xl"></div>
          <div class="animate-float absolute -bottom-12 -left-10 h-56 w-56 rounded-full bg-sky-400/12 blur-2xl"></div>

          <div class="relative flex h-full flex-col p-6">
            <div class="inline-flex items-center gap-2 self-start rounded-full border border-white/10 bg-white/10 px-3 py-1 text-xs font-semibold text-white/90 backdrop-blur">
              <span class="inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
              Profile
            </div>

            <div class="mt-auto">
              <div class="text-2xl font-semibold text-white">{site.person.name}</div>
              <div class="mt-1 text-sm font-semibold text-slate-200">
                {site.person.role} • {site.person.affiliation}
              </div>
              <div class="mt-1 text-xs font-semibold text-slate-300/90">{site.person.location}</div>

              <div class="mt-5">
                <div class="text-xs font-semibold text-slate-200/90">Work with</div>
                <div class="mt-2 text-sm font-semibold text-slate-100/95">
                  {site.trust.map((t, i) => (
                    <>
                      <span>{t}</span>
                      {i < site.trust.length - 1 ? <span class="mx-2 text-slate-300/80">•</span> : null}
                    </>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        <aside class="mt-6 md:absolute md:-bottom-8 md:left-6 md:right-6">
          <div class="relative overflow-hidden rounded-[28px] p-[1px] shadow-sm md:shadow-glow">
            <div class="absolute inset-0 bg-gradient-to-br from-brand-500/45 via-sky-500/25 to-emerald-400/35"></div>
            <div class="relative rounded-[27px] bg-white/78 p-5 backdrop-blur-xl dark:bg-slate-950/45">
              <div class="flex items-center justify-between gap-4">
                <div class="text-xs font-semibold text-slate-800 dark:text-slate-200">I help with</div>
                <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">Web • UI • Learning</div>
              </div>
              <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-slate-700 marker:text-brand-600 dark:text-slate-200 dark:marker:text-brand-400">
                <li>Fast, responsive landing pages & portfolios (Astro + Tailwind)</li>
                <li>Small Node.js APIs for learning and prototypes</li>
                <li>Clean UI, accessibility basics, and performance</li>
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="mt-16 grid gap-4 md:grid-cols-3">
    <div class="surface rounded-3xl p-6">
      <div class="text-sm font-semibold text-slate-900 dark:text-white">Quick info</div>
      <dl class="mt-4 grid gap-3 text-sm">
        <div class="flex items-center justify-between gap-4">
          <dt class="text-slate-600 dark:text-slate-300">Age</dt>
          <dd class="font-semibold text-slate-900 dark:text-white">{site.person.age}</dd>
        </div>
        <div class="flex items-center justify-between gap-4">
          <dt class="text-slate-600 dark:text-slate-300">Education</dt>
          <dd class="text-right font-semibold text-slate-900 dark:text-white">{site.person.affiliation}</dd>
        </div>
        <div class="flex items-center justify-between gap-4">
          <dt class="text-slate-600 dark:text-slate-300">Location</dt>
          <dd class="font-semibold text-slate-900 dark:text-white">{site.person.location}</dd>
        </div>
      </dl>
    </div>

    <div class="surface rounded-3xl p-6 md:col-span-2">
      <div class="flex items-end justify-between gap-6">
        <div class="text-sm font-semibold text-slate-900 dark:text-white">Skills</div>
        <a class="text-sm font-semibold text-brand-700 hover:underline dark:text-brand-300" href="/about">
          More →
        </a>
      </div>
      <div class="mt-4 flex flex-wrap gap-2">
        {site.person.skills.map((s) => (
          <span class="surface rounded-full px-3 py-1 text-xs font-semibold text-slate-700 dark:text-slate-200">{s}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="mt-16">
    <div class="flex items-end justify-between gap-6">
      <h2 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Gallery</h2>
      <a class="text-sm font-semibold text-brand-700 hover:underline dark:text-brand-300" href="/projects">
        View projects →
      </a>
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {gallery.map((src) => (
        <div class="surface group relative overflow-hidden rounded-3xl border border-slate-200/70 dark:border-white/10">
          <img
            src={src}
            alt=""
            loading="lazy"
            decoding="async"
            class="h-44 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950/30 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-16">
    <div class="flex items-end justify-between gap-6">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Featured projects</h2>
        <p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-300">
          A few recent things I’ve built (and what I learned from them).
        </p>
      </div>
      <a class="text-sm font-semibold text-brand-700 hover:underline dark:text-brand-300" href="/projects">
        View all →
      </a>
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {projects.map((p) => (
        <a
          href={`/projects/${p.id}`}
          class="surface group relative overflow-hidden rounded-3xl p-6 card-hover"
        >
          {p.data.image ? (
            <>
              <img
                src={p.data.image}
                alt=""
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-22"
              />
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950/35 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
            </>
          ) : null}
          <div class="absolute -right-10 -top-10 h-32 w-32 rounded-full bg-brand-500/10 blur-2xl"></div>
          <div class="absolute -bottom-12 -left-10 h-40 w-40 rounded-full bg-emerald-400/10 blur-2xl"></div>
          <div class="relative">
            <div class="flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-600 dark:text-slate-300">
              <span class="surface rounded-full px-3 py-1">{p.data.category}</span>
              <span class="surface rounded-full px-3 py-1">{new Date(p.data.publishedAt).toLocaleDateString()}</span>
            </div>
            <h3 class="mt-3 text-base font-semibold text-slate-900 group-hover:underline dark:text-white">
              {p.data.title}
            </h3>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{p.data.summary}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {p.data.stack.slice(0, 4).map((t) => (
                <span class="surface rounded-full px-3 py-1 text-xs font-semibold text-slate-700 dark:text-slate-200">
                  {t}
                </span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  {
    site.testimonials.length ? (
      <section class="mt-16">
        <div class="grid gap-4 md:grid-cols-2">
          {site.testimonials.map((t) => (
            <figure class="surface rounded-3xl p-6">
              <blockquote class="text-sm leading-relaxed text-slate-700 dark:text-slate-200">
                “{t.quote}”
              </blockquote>
              <figcaption class="mt-4 text-xs font-semibold text-slate-600 dark:text-slate-300">
                {t.name} — {t.title}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    ) : (
      <section class="mt-16">
        <div class="surface rounded-3xl p-8">
          <h2 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">
            Want to work together?
          </h2>
          <p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-300">
            If you have a website idea or a small app you want to ship, send me a message.
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a
              href="/contact"
              class="animate-shimmer inline-flex items-center justify-center rounded-xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-glow hover:bg-brand-700"
            >
              Contact
            </a>
            <a
              href="/projects"
              class="surface inline-flex items-center justify-center rounded-xl px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-white/80 dark:text-slate-100 dark:hover:bg-slate-950/60"
            >
              View projects
            </a>
          </div>
        </div>
      </section>
    )
  }

  <section class="mt-16">
    <div class="rounded-3xl border border-white/10 bg-slate-950/70 p-8 shadow-glow">
      <h2 class="text-2xl font-semibold tracking-tight text-white">Let’s build something simple and solid</h2>
      <p class="mt-2 max-w-2xl text-sm text-slate-300">
        I’m happy to help with a portfolio, landing page, or a small web project.
      </p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-glow hover:bg-brand-700"
        >
          Contact
        </a>
        <a
          href="/projects"
          class="inline-flex items-center justify-center rounded-xl border border-white/10 bg-white/5 px-5 py-3 text-sm font-semibold text-white hover:bg-white/10"
        >
          View projects
        </a>
      </div>
    </div>
  </section>
</Layout>
