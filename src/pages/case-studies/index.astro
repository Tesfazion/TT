---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const caseStudies = (await getCollection("case-studies")).sort(
  (a, b) => +new Date(b.data.publishedAt) - +new Date(a.data.publishedAt)
);
---

<Layout title="Case Studies" description="Selected work: outcomes, approach, and measurable impact.">
  <section class="surface relative overflow-hidden rounded-3xl p-8">
    <img
      src="/images/library/cyber-security/72115b32f954509221c1190f116c1e2f.jpg"
      alt=""
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover opacity-18"
    />
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_25%_20%,rgba(239,68,68,0.18),transparent_60%)]"></div>
    <div class="relative flex flex-col gap-2">
      <h1 class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-white">Case Studies</h1>
      <p class="max-w-2xl text-sm text-slate-600 dark:text-slate-300">
        Selected work: outcomes, approach, and measurable impact — written for executives and technical stakeholders.
      </p>
    </div>
  </section>

  <div class="mt-8 grid gap-4 md:grid-cols-2">
    {caseStudies.map((c) => (
      <a
        href={`/case-studies/${c.id}`}
        class="surface group relative overflow-hidden rounded-3xl p-6 card-hover"
      >
        <img
          src="/images/tech/wave.svg"
          alt=""
          loading="lazy"
          decoding="async"
          class="pointer-events-none absolute inset-0 h-full w-full opacity-0 transition-opacity duration-500 group-hover:opacity-30 dark:group-hover:opacity-18"
        />
        <div class="pointer-events-none absolute -right-10 -top-10 h-32 w-32 rounded-full bg-brand-500/10 blur-2xl"></div>
        <div class="pointer-events-none absolute -bottom-12 -left-10 h-40 w-40 rounded-full bg-sky-400/10 blur-2xl"></div>

        <div class="relative">
          <div class="flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-600 dark:text-slate-300">
            <span class="surface rounded-full px-3 py-1">
              {c.data.industry}
            </span>
            <span class="surface rounded-full px-3 py-1">
              {new Date(c.data.publishedAt).toLocaleDateString()}
            </span>
            <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-800 dark:bg-white/5 dark:text-brand-200">
              {c.data.role}
            </span>
          </div>
          <h2 class="mt-3 text-lg font-semibold text-slate-900 group-hover:underline dark:text-white">{c.data.title}</h2>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{c.data.summary}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {c.data.metrics.slice(0, 3).map((m) => (
              <span class="surface rounded-full px-3 py-1 text-xs font-semibold text-slate-700 dark:text-slate-200">
                {m}
              </span>
            ))}
          </div>
        </div>
      </a>
    ))}
  </div>
</Layout>
