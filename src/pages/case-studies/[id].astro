---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("case-studies");
  return entries.map((entry) => ({ params: { id: entry.id } }));
}

const { id } = Astro.params;
if (!id) throw new Error("Missing case study id");

const entry = await getEntry("case-studies", id);
if (!entry) return Astro.redirect("/404");

const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.summary} containerClass="max-w-screen-2xl">
  <section class="surface relative overflow-hidden rounded-3xl p-8">
    <img
      src="/images/library/cyber-security/1def7e6ffa2417f6f5785fee43443f00.jpg"
      alt=""
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover opacity-16"
    />
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_25%_20%,rgba(99,102,241,0.18),transparent_60%)]"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-white/40 via-white/10 to-white/0 dark:from-slate-950/30 dark:via-slate-950/20 dark:to-slate-950/0"></div>

    <div class="relative grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <a class="text-sm font-semibold text-brand-700 hover:underline dark:text-brand-300" href="/case-studies">
          ← Back to case studies
        </a>
        <h1 class="mt-3 text-balance text-3xl font-semibold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
          {entry.data.title}
        </h1>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 dark:text-slate-300">{entry.data.summary}</p>

        <div class="mt-5 flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-700 dark:text-slate-200">
          <span class="surface rounded-full px-3 py-1">{entry.data.industry}</span>
          <span class="surface rounded-full px-3 py-1">{entry.data.role}</span>
          <span class="surface rounded-full px-3 py-1">{new Date(entry.data.publishedAt).toLocaleDateString()}</span>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="surface-strong rounded-3xl p-6">
          <div class="text-sm font-semibold text-slate-900 dark:text-white">At a glance</div>
          <dl class="mt-4 grid gap-3 text-sm">
            <div class="flex items-center justify-between gap-4">
              <dt class="text-slate-600 dark:text-slate-300">Industry</dt>
              <dd class="font-semibold text-slate-900 dark:text-white">{entry.data.industry}</dd>
            </div>
            <div class="flex items-center justify-between gap-4">
              <dt class="text-slate-600 dark:text-slate-300">Role</dt>
              <dd class="font-semibold text-slate-900 dark:text-white">{entry.data.role}</dd>
            </div>
            <div class="flex items-center justify-between gap-4">
              <dt class="text-slate-600 dark:text-slate-300">Published</dt>
              <dd class="font-semibold text-slate-900 dark:text-white">
                {new Date(entry.data.publishedAt).toLocaleDateString()}
              </dd>
            </div>
          </dl>

          {entry.data.metrics.length ? (
            <div class="mt-5">
              <div class="text-sm font-semibold text-slate-900 dark:text-white">Key results</div>
              <div class="mt-3 space-y-2 text-sm text-slate-700 dark:text-slate-200">
                {entry.data.metrics.slice(0, 4).map((m) => (
                  <div class="flex gap-2">
                    <span class="mt-1 h-1.5 w-1.5 rounded-full bg-brand-500"></span>
                    <span>{m}</span>
                  </div>
                ))}
              </div>
            </div>
          ) : null}
        </div>
      </div>
    </div>
  </section>

  <div class="mt-10 grid gap-6 lg:grid-cols-12">
    <article class="lg:col-span-8">
      <div class="surface rounded-3xl p-6">
        <div class="prose prose-slate max-w-none dark:prose-invert">
          <Content />
        </div>
      </div>
    </article>

    <aside class="lg:col-span-4">
      <div class="surface sticky top-24 rounded-3xl p-6">
        <div class="text-sm font-semibold text-slate-900 dark:text-white">Tech</div>
        <div class="mt-3 flex flex-wrap gap-2">
          {entry.data.tech.map((t) => (
            <span class="surface rounded-full px-3 py-1 text-xs font-semibold text-slate-700 dark:text-slate-200">
              {t}
            </span>
          ))}
        </div>

        <div class="mt-6 rounded-2xl border border-white/10 bg-slate-950/70 p-5">
          <div class="text-sm font-semibold text-white">Want similar outcomes?</div>
          <p class="mt-2 text-sm text-slate-300">
            Share your context and constraints — I’ll respond with next steps and a realistic plan.
          </p>
          <a
            href="/contact"
            class="mt-4 inline-flex w-full items-center justify-center rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-glow hover:bg-brand-700"
          >
            Contact
          </a>
        </div>
      </div>
    </aside>
  </div>
</Layout>
