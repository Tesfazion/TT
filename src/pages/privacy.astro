---
import Layout from "../layouts/Layout.astro";
import { site } from "../config/site";

const email = site.contact.personalEmail?.trim() || site.contact.companyEmail?.trim();
---

<Layout title="Privacy" description="Privacy policy for this portfolio site.">
  <section class="surface rounded-3xl p-8">
    <h1 class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-white">Privacy Policy</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-300">
      A short, plain‑language note about what this site collects (not much) and what happens when you contact me.
    </p>
  </section>
  <div class="prose prose-slate mt-6 max-w-none dark:prose-invert">
    <p><strong>Effective date:</strong> {new Date().toLocaleDateString()}</p>

    <p>
      This Privacy Policy explains how <strong>{site.person.name}</strong> handles information when you visit this website.
    </p>

    <h2>Information I collect</h2>
    <ul>
      <li>
        <strong>Messages you send:</strong>{" "}
        {
          email ? (
            <>
              If you contact me by email at <a href={`mailto:${email}`}>{email}</a>, I receive the information you include
              (for example your name, email address, and message).
            </>
          ) : (
            <>If you contact me by email, I receive the information you include (for example your name, email address, and message).</>
          )
        }
      </li>
      <li>
        <strong>Basic technical data:</strong> Like most websites, the hosting provider may process standard server logs
        (for example IP address, browser type, pages requested) for security and reliability.
      </li>
      <li>
        <strong>Theme preference:</strong> This site stores your light/dark mode choice in your browser (localStorage) so
        the site remembers your preference. This is not sent to me.
      </li>
    </ul>

    <h2>How I use information</h2>
    <ul>
      <li>To respond to your inquiries and provide requested services.</li>
      <li>To maintain site security and reliability.</li>
    </ul>

    <h2>Sharing</h2>
    <p>
      I do not sell personal information. Information may be processed by service providers needed to run the website
      (hosting, email provider) or when required by law.
    </p>

    <h2>Third‑party links</h2>
    <p>
      This website may include links to third‑party sites (social media, messaging). Their privacy practices are handled
      by them, not me. Review their policies before providing personal information.
    </p>

    <h2>Data retention</h2>
    <p>
      I keep messages and related information only as long as needed to respond and for basic recordkeeping, unless a
      longer period is required by law.
    </p>

    <h2>Contact</h2>
    <p>
      Questions about this policy?{" "}
      {email ? <a href={`mailto:${email}`}>Email us</a> : <>Email us using the address on the contact page.</>}
    </p>
  </div>
</Layout>
